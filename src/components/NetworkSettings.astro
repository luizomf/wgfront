---
import { DEFAULT_DNS } from '../lib/dns';
---

<section class="section" id="network-settings">
  <div class="net__prompt">
    <span class="text-accent">$</span>
    <span class="text-secondary">configure</span>
  </div>
  <div class="net__fields">
    <div class="net__field">
      <label for="subnet">--subnet</label>
      <input type="text" id="subnet" value="10.100.0" placeholder="10.100.0" />
    </div>
    <div class="net__field">
      <label for="port">--port</label>
      <input type="number" id="port" value="51820" min="1" max="65535" />
    </div>
    <div class="net__field">
      <label for="keepalive">--keepalive</label>
      <input type="number" id="keepalive" value="25" min="0" max="600" />
    </div>
    <div class="net__field">
      <label for="topology">--topology</label>
      <select id="topology" aria-describedby="topology-help">
        <option value="mesh" selected>mesh</option>
        <option value="hub-spoke">hub-spoke</option>
        <option value="hybrid">hybrid</option>
      </select>
    </div>
    <div class="net__field">
      <label for="network-gateway">Gateway padrão</label>
      <select id="network-gateway" aria-describedby="gateway-help">
        <option value="">Não selecionado</option>
      </select>
    </div>
  </div>
  <div class="net__field net__dns">
    <label for="network-dns">DNS padrão da rede (Full Tunnel)</label>
    <input type="text" id="network-dns" value={DEFAULT_DNS}
      aria-describedby="network-dns-help network-dns-error" spellcheck="false" />
    <p class="net__help text-secondary" id="network-dns-help">
      Usado por nós em Full Tunnel que herdam o DNS da rede. Em Split Tunnel,
      a herança não adiciona DNS. Informe endereços IPv4 ou IPv6 separados por
      vírgula ou espaço; vazio omite a linha DNS e mantém as configurações do sistema.
    </p>
    <p class="net__help text-secondary" id="network-dns-error" hidden></p>
  </div>
  <label>
    <input type="checkbox" id="network-psk" aria-describedby="psk-help" />
    Usar PSK
  </label>
  <p class="net__help text-secondary" id="psk-help">
    Chave extra opcional, criada automaticamente para cada conexão. Após regerar
    as chaves, instale as configurações correspondentes nas duas pontas.
  </p>
  <p class="net__help" id="network-change-error" role="alert" hidden></p>
  <p class="net__help text-secondary" id="topology-help"></p>
  <p class="net__help text-secondary" id="gateway-help">
    Full Tunnel exige um gateway explícito em qualquer topologia: ele recebe as
    rotas /0; os demais pares diretos, /32 e /128. Cada nó pode substituir o padrão.
    NAT Gateway gera regras de firewall, não escolhe rotas;
    o gateway também pode usar um firewall configurado externamente.
  </p>
</section>

<style>
  .net__prompt {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.5rem;
  }

  .net__fields {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .net__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 140px;
  }

  .net__field input,
  .net__field select {
    width: 100%;
    min-width: 0;
  }

  .net__dns {
    margin-top: 1rem;
  }

  .net__dns input[aria-invalid="true"] {
    border-color: var(--danger);
  }

  .net__help {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
</style>

<script>
  import { updateNetwork, getState, subscribe } from '../lib/store';
  import type { Topology } from '../lib/types';
  import { parseDnsServers } from '../lib/dns';

  const pskInput = document.getElementById('network-psk') as HTMLInputElement;
  const changeError = document.getElementById('network-change-error')!;

  const dnsInput = document.getElementById('network-dns') as HTMLInputElement;
  const dnsError = document.getElementById('network-dns-error')!;

  const subnetInput = document.getElementById('subnet') as HTMLInputElement;
  const portInput = document.getElementById('port') as HTMLInputElement;
  const keepaliveInput = document.getElementById(
    'keepalive',
  ) as HTMLInputElement;
  const topologySelect = document.getElementById(
    'topology',
  ) as HTMLSelectElement;

  const gatewaySelect = document.getElementById('network-gateway') as HTMLSelectElement;
  const topologyHelp = document.getElementById('topology-help')!;
  const topologyDescriptions: Record<Topology, string> = {
    mesh: 'Mesh: todos os nós se conectam diretamente. Papéis são ignorados; em Split Tunnel, apenas rotas de host (/32 e /128).',
    'hub-spoke': 'Hub-spoke: hubs se conectam a todos; spokes, apenas aos hubs. Em Split Tunnel, cada spoke precisa de um gateway hub explícito: só ele recebe a sub-rede WireGuard; os demais hubs recebem rotas de host.',
    hybrid: 'Hybrid: servidores se conectam a todos; clientes, apenas aos servidores. Em Split Tunnel, apenas rotas de host (/32 e /128), sem retransmissão WireGuard entre clientes. Gateway só é obrigatório em Full Tunnel.',
  };
  let gatewayOptionsKey = '';

  function render(): void {
    const { peers, network } = getState();
    if (subnetInput !== document.activeElement) subnetInput.value = network.subnet;
    if (portInput !== document.activeElement) portInput.value = String(network.port);
    if (keepaliveInput !== document.activeElement) keepaliveInput.value = String(network.keepalive);
    if (dnsInput !== document.activeElement) dnsInput.value = network.dns;
    let dnsMessage = '';
    try {
      parseDnsServers(network.dns);
    } catch (error) {
      dnsMessage = error instanceof Error ? error.message : 'DNS inválido.';
    }
    dnsInput.setAttribute('aria-invalid', String(Boolean(dnsMessage)));
    dnsError.textContent = dnsMessage;
    dnsError.hidden = !dnsMessage;
    pskInput.checked = network.usePsk;
    topologySelect.value = network.topology;
    topologyHelp.textContent = topologyDescriptions[network.topology];

    const options = [
      { value: '', label: 'Não selecionado', disabled: false },
      ...peers.map((peer) => ({
        value: peer.id,
        label: `${peer.name || 'Sem nome'} (#${peer.id})`,
        disabled: false,
      })),
    ];
    if (network.gatewayId && !peers.some((peer) => peer.id === network.gatewayId)) {
      options.push({
        value: network.gatewayId,
        label: `Nó removido (#${network.gatewayId}) — selecione outro`,
        disabled: true,
      });
    }
    const optionsKey = JSON.stringify(options);
    if (optionsKey !== gatewayOptionsKey) {
      gatewaySelect.replaceChildren(...options.map(({ value, label, disabled }) => {
        const option = new Option(label, value);
        option.disabled = disabled;
        return option;
      }));
      gatewayOptionsKey = optionsKey;
    }
    gatewaySelect.value = network.gatewayId;
  }

  dnsInput.addEventListener('input', () => {
    updateNetwork({ dns: dnsInput.value });
  });

  gatewaySelect.addEventListener('change', () => {
    updateNetwork({ gatewayId: gatewaySelect.value });
  });

  subnetInput.addEventListener('input', () => {
    updateNetwork({ subnet: subnetInput.value });
  });

  portInput.addEventListener('input', () => {
    const val = parseInt(portInput.value, 10);
    if (!isNaN(val)) updateNetwork({ port: val });
  });

  keepaliveInput.addEventListener('input', () => {
    const val = parseInt(keepaliveInput.value, 10);
    if (!isNaN(val)) updateNetwork({ keepalive: val });
  });

  function changeConnections(partial: Parameters<typeof updateNetwork>[0]): void {
    try {
      updateNetwork(partial);
      changeError.hidden = true;
    } catch {
      render();
      changeError.textContent = 'Não foi possível gerar as PSKs. Nada foi alterado. Tente novamente.';
      changeError.hidden = false;
    }
  }

  topologySelect.addEventListener('change', () => {
    changeConnections({ topology: topologySelect.value as Topology });
  });
  pskInput.addEventListener('change', () => {
    changeConnections({ usePsk: pskInput.checked });
  });

  subscribe(render);
  render();
</script>
